# Gemini 3 (hackathon requirement) — get key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash

# Elastic MCP (hackathon partner — Elastic track)
# 1. Elastic Cloud Serverless free trial: https://cloud.elastic.co/
# 2. Kibana → Agent Builder → Tools → Manage MCP → Copy MCP Server URL
# 3. Stack Management → API Keys → create key with Agent Builder read access
ELASTIC_MCP_URL=
ELASTIC_API_KEY=

# Direct Elasticsearch fallback (optional — for seed_elastic.py)
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# Set false after Elastic MCP is configured (true = mock demo logs only)
DEMO_MODE=true

# Server
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
